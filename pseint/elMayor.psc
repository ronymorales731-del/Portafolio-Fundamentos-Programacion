Proceso elMayor
	//Autor: Elmer G.
	//Programa: El mayor de 2 números
	//Fecha: 13-02-2023
	//Declaración de variables
	definir N1, N2, M Como Real;
	Escribir "Digite el primer número";
	Leer N1;
	Escribir "Digite el segundo número";
	Leer N2;
	//Comparar números
	si N1>N2 entonces
			M = N1;
	sino 
			M = N2;
	FinSi
	Escribir "El mayor es: ", M;
FinProceso
