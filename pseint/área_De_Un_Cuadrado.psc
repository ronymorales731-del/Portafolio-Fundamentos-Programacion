Proceso Área_De_Un_Cuadrado
	Definir Area, long, lado Como Real;
	//PEDIR DATOS
	Escribir "Identidique la longitud de un lado del cuadrado:";
	Repetir
		Escribir "Ingrese la long del lado (longitud) :";
		Leer long;
	Hasta Que long>0

	//Proceso 
	Area<- long * long;
	//Salida
	Escribir "Area =  ", Area;
FinProceso